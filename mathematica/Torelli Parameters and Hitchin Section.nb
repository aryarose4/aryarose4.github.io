Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "We", " ", "now", " ", "regard", " ", "these", " ", "variables", " ", "as",
     " ", "tangent", " ", "space", " ", "coordinates", " ", "at", " ", "a", 
    " ", "point", " ", "in", " ", "the", " ", "Hitchin", " ", 
    RowBox[{"section", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{"(", GridBox[{
        {"x11", "x12", "x13", "x14"},
        {"x21", "x22", "x23", "x24"}
       }], ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{"(", GridBox[{
        {"y11", "y12"},
        {"y21", "y22"},
        {
         RowBox[{"y31", " "}], "y32"},
        {
         RowBox[{"y41", " "}], "y42"}
       }], ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4", 
       ",", 
       RowBox[{"(", GridBox[{
          {"h", "e"},
          {"f", 
           RowBox[{"-", "h"}]}
         }], ")"}]}], "}"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
    "Arbitrary", " ", "element", " ", "of", " ", "Lie", " ", "algebra"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "Lie", " ", "algebra", " ", "action"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"algActx", "[", 
     RowBox[{"A_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"A", "[", 
          RowBox[{"[", "5", "]"}], "]"}], ".", 
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "i"}], "]"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "i"}], "]"}], "]"}], 
         RowBox[{"A", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], "\[Transpose]"}]}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"algActy", "[", 
     RowBox[{"A_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        RowBox[{"y", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "All"}], "]"}], "]"}]}], "-", 
       RowBox[{
        RowBox[{"y", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "All"}], "]"}], "]"}], ".", 
        RowBox[{"A", "[", 
         RowBox[{"[", "5", "]"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Ensures", " ", "orthogonality", " ", "to", " ", "the", " ", 
     "instantaneous", " ", "group", " ", "action"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"actionCondition", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"algActx", "[", 
            RowBox[{"A", ",", 
             RowBox[{"xNumerical", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ".", 
           RowBox[{"x", "\[Transpose]"}]}], "]"}], "+", 
         RowBox[{"Tr", "[", 
          RowBox[{
           RowBox[{"algActy", "[", 
            RowBox[{"A", ",", 
             RowBox[{"yNumerical", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ".", 
           RowBox[{"y", "\[Transpose]"}]}], "]"}]}], "==", "0"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Do", " ", "I", " ", "need", " ", "a", " ", "conjugate", " ", 
      "transpose", " ", 
      RowBox[{"here", "?", "  ", "I"}], " ", "think", " ", "not"}], ",", " ", 
     RowBox[{
      RowBox[{"because", " ", 
       RowBox[{"we", "'"}], "re", " ", "solving", " ", "for", " ", "a", " ", 
       "C"}], "-", "subspace"}], ",", " ", 
