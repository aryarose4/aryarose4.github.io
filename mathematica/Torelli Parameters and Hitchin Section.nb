Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"Disable", ":", "\[IndentingNewLine]", 
     RowBox[{"groupActx", "[", 
      RowBox[{"g_", ",", "x_"}], "]"}]}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"g", "[", 
           RowBox[{"[", "5", "]"}], "]"}], ".", 
          RowBox[{"x", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "i"}], "]"}], "]"}]}], " ", 
         SuperscriptBox[
          RowBox[{"g", "[", 
           RowBox[{"[", "i", "]"}], "]"}], 
          RowBox[{"-", "1"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], "\[Transpose]"}], 
     "\[IndentingNewLine]", 
     RowBox[{"x", "=", 
      RowBox[{"(", GridBox[{
         {"1", "1", "1", "0"},
         {
          RowBox[{"v", "+", 
           RowBox[{"\[ImaginaryI]", " ", "w"}]}], "0", "1", "1"}
        }], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"y", "=", 
    RowBox[{"(", GridBox[{
       {"0", "0"},
       {"0", "0"},
       {"0", "0"},
       {"0", "0"}
      }], ")"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"A", "=", 
    RowBox[{"(", GridBox[{
       {"a", "b"},
       {
        RowBox[{"c", "+", 
         RowBox[{"\[ImaginaryI]", " ", "ic"}]}], "d"}
      }], ")"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"g", "=", 
    RowBox[{"{", 
     RowBox[{
     "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3", ",", "\[Lambda]4", 
      ",", "A"}], "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"vars", "=", 
    RowBox[{"{", 
     RowBox[{
     "v", ",", "w", ",", "a", ",", "ia", ",", "b", ",", "ib", ",", "c", ",", 
      "ic", ",", "d", ",", "\[Lambda]1", ",", "\[Lambda]2", ",", "\[Lambda]3",
       ",", "\[Lambda]4"}], "}"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"Realify", "=", 
    RowBox[{
     RowBox[{"Refine", "[", 
      RowBox[{"#", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "\[Element]", "Reals"}], "&"}], "/@", "vars"}]}], "]"}],
      "&"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"CStarRules", "=", 
    RowBox[{"Simplify", "@", 
     RowBox[{"Realify", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Lambda]1", "->", 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"A", ".", 
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}], ".", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"A", ".", 
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}], 
             "\[Conjugate]"}]}], 
           RowBox[{"2", 
            RowBox[{"\[Beta]", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]]]}], ",", 
        RowBox[{"\[Lambda]2", "->", 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"A", ".", 
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ")"}], ".", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"A", ".", 
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ")"}], 
             "\[Conjugate]"}]}], 
           RowBox[{"2", 
            RowBox[{"\[Beta]", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}]]]}], ",", 
        RowBox[{"\[Lambda]3", "->", 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"A", ".", 
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ")"}], ".", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"A", ".", 
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ")"}], 
             "\[Conjugate]"}]}], 
           RowBox[{"2", 
            RowBox[{"\[Beta]", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]]]}], ",", 
        RowBox[{"\[Lambda]4", "->", 
         SqrtBox[
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"A", ".", 
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ")"}], ".", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"A", ".", 
