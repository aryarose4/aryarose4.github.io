Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MakeHyperpolygonTest", "=", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rin", ",", "\[Theta]in", ",", "tin"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "specializationRules", ",", "xTemp", ",", "yTemp", ",", "a12", ",", 
          "b12", ",", "a22", ",", "gSimple", ",", "gApprox", ",", 
          "parameters", ",", "parameterRules", ",", "searchMin", ",", 
          "searchMax", ",", "counter", ",", "i", ",", "distances", ",", 
          "newRule", ",", "output"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"specializationRules", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"r", "->", "rin"}], ",", 
            RowBox[{"\[Theta]", "->", "\[Theta]in"}], ",", 
            RowBox[{"t", "->", "tin"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"xTemp", "=", 
          RowBox[{"x", "/.", "specializationRules"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"yTemp", "=", 
          RowBox[{"y", "/.", "specializationRules"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"parameters", "=", 
          RowBox[{"{", 
           RowBox[{"a12", ",", "b12", ",", "a22"}], "}"}]}], ";", 
         RowBox[{"parameterRules", "=", 
          RowBox[{"Thread", "[", 
           RowBox[{"parameters", "->", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"gSimple", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"(", GridBox[{
               {"1", 
                RowBox[{"a12", "+", 
                 RowBox[{"\[ImaginaryI]", " ", "b12"}]}]},
               {"0", 
                SuperscriptBox["a22", "2"]}
              }], ")"}], ",", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"searchMin", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "1"}], ",", 
            RowBox[{"-", "1"}], ",", "0.01"}], "}"}]}], ";", 
         RowBox[{"searchMax", "=", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1", ",", "2"}], "}"}]}], ";", 
         RowBox[{"counter", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"distances", "=", 
          RowBox[{"{", 
           RowBox[{"Measure2Norm", "@@", 
            RowBox[{"(", 
             RowBox[{"Fix\[Mu]U1", "[", 
              RowBox[{"xTemp", ",", "yTemp"}], "]"}], ")"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"newRule", "=", 
          RowBox[{"FindRoot", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Re", "@", 
               RowBox[{
                RowBox[{"projections", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "@", 
                RowBox[{"\[Mu]SU2Isolated", "[", 
                 RowBox[{
                  RowBox[{"groupActx", "[", 
                   RowBox[{"gSimple", ",", "xTemp"}], "]"}], ",", 
                  RowBox[{"groupActy", "[", 
                   RowBox[{"gSimple", ",", "yTemp"}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"a12", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"b12", ",", "0"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"a22", ",", "1"}], "}"}]}], "}"}], ",", 
            RowBox[{"AccuracyGoal", "->", "1"}], ",", 
            RowBox[{"PrecisionGoal", "->", "1"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"output", "=", 
          RowBox[{
           RowBox[{"Fix\[Mu]U1V2", "@@", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"groupActx", "[", 
               RowBox[{"gSimple", ",", "xTemp"}], "]"}], ",", 
              RowBox[{"groupActy", "[", 
               RowBox[{"gSimple", ",", "yTemp"}], "]"}]}], "}"}]}], "/.", 
           "newRule"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"IsAccurate", "@@", "output"}], ",", "output", ",", 
           RowBox[{"MakeHyperpolygonMoreStable", "[", 
            RowBox[{"rin", ",", "\[Theta]in", ",", "tin"}], "]"}]}], 
          "]"}]}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.960990420211363*^9, 3.960990497239826*^9}, {
   3.96099053017191*^9, 3.9609906807245636`*^9}, {3.960991849215143*^9, 
