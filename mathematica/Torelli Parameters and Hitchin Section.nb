                    RowBox[{"2", ",", "0"}], ")"}],
                   Derivative],
                  MultilineFunction->None], "[", 
                 RowBox[{"u", ",", "v"}], "]"}]}], ")"}]}]}], ")"}]}]}], 
         ")"}]}]}], "\[Equal]", "0"}]}], "}"}], ",", 
