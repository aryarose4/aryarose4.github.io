     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Mu]U1", "[", 
          RowBox[{
           RowBox[{"groupActx", "[", 
            RowBox[{"g0", ",", "x1"}], "]"}], ",", "y0"}], "]"}], "-", 
         "\[Beta]Test"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"projections", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
