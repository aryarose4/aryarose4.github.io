Cell[BoxData[
 RowBox[{
  RowBox[{"MakeHyperpolygonMostStable", "=", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rin", ",", "\[Theta]in", ",", "tin"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "specializationRules", ",", "xTemp", ",", "yTemp", ",", "a12", ",", 
         "b12", ",", "a22", ",", "gSimple", ",", "gApprox", ",", "parameters",
          ",", "parameterRules", ",", "searchMin", ",", "searchMax", ",", 
         "counter", ",", "i", ",", "distances", ",", "newRule"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"specializationRules", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", "->", "rin"}], ",", 
           RowBox[{"\[Theta]", "->", "\[Theta]in"}], ",", 
           RowBox[{"t", "->", "tin"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xTemp", "=", 
         RowBox[{"x", "/.", "specializationRules"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"yTemp", "=", 
         RowBox[{"y", "/.", "specializationRules"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"parameters", "=", 
         RowBox[{"{", 
          RowBox[{"a12", ",", "b12", ",", "a22"}], "}"}]}], ";", 
        RowBox[{"parameterRules", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{"parameters", "->", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gSimple", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"(", GridBox[{
              {"1", 
               RowBox[{"a12", "+", 
                RowBox[{"\[ImaginaryI]", " ", "b12"}]}]},
              {"0", "a22"}
             }], ")"}], ",", 
           RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"searchMin", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "1"}], ",", 
           RowBox[{"-", "1"}], ",", "0.01"}], "}"}]}], ";", 
        RowBox[{"searchMax", "=", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1", ",", "2"}], "}"}]}], ";", 
        RowBox[{"counter", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"distances", "=", 
         RowBox[{"{", 
          RowBox[{"Measure2Norm", "@@", 
           RowBox[{"(", 
            RowBox[{"Fix\[Mu]U1", "[", 
             RowBox[{"xTemp", ",", "yTemp"}], "]"}], ")"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Last", "@", "distances"}], ">", "TOLERANCE"}], "&&", 
           RowBox[{"counter", "<=", "12"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"i", "=", 
            RowBox[{"Mod", "[", 
             RowBox[{"counter", ",", "3", ",", "1"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"gApprox", "=", 
            RowBox[{"gSimple", "/.", 
             RowBox[{"Delete", "[", 
              RowBox[{"parameterRules", ",", "i"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"newRule", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"FindRoot", "[", 
                 RowBox[{
                  RowBox[{"Re", "@", 
                   RowBox[{"Abs", "@", 
                    RowBox[{
                    RowBox[{"projections", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "[", 
                    RowBox[{"\[Mu]SU2Isolated", "[", 
                    RowBox[{
                    RowBox[{"groupActx", "[", 
                    RowBox[{"gApprox", ",", "xTemp"}], "]"}], ",", 
                    RowBox[{"groupActy", "[", 
                    RowBox[{"gApprox", ",", "yTemp"}], "]"}]}], "]"}], 
                    "]"}]}]}], ",", 
                  RowBox[{"{", 
                   RowBox[{"#", ",", 
                    FractionBox["1", "2"]}], "}"}], ",", 
                  RowBox[{"AccuracyGoal", "->", "2"}], ",", 
                  RowBox[{"PrecisionGoal", "->", "1"}], ",", 
                  RowBox[{"DampingFactor", "->", "2"}]}], "]"}], "&"}], "[", 
               RowBox[{"parameters", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "//", "Quiet"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", "newRule", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"distances", ",", 
             RowBox[{"Measure2Norm", "@@", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Fix\[Mu]U1V2", "[", 
                 RowBox[{
                  RowBox[{"groupActx", "[", 
                   RowBox[{"gApprox", ",", "xTemp"}], "]"}], ",", 
                  RowBox[{"groupActy", "[", 
                   RowBox[{"gApprox", ",", "yTemp"}], "]"}]}], "]"}], "/.", 
                "newRule"}], ")"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"distances", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "<=", 
              RowBox[{"distances", "[", 
               RowBox[{"[", 
                RowBox[{"-", "2"}], "]"}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"xTemp", "=", 
               RowBox[{
                RowBox[{"groupActx", "[", 
                 RowBox[{"gApprox", ",", "xTemp"}], "]"}], "/.", 
                "newRule"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"yTemp", "=", 
               RowBox[{
                RowBox[{"groupActy", "[", 
                 RowBox[{"gApprox", ",", "yTemp"}], "]"}], "/.", 
                "newRule"}]}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"counter", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Fix\[Mu]U1", "[", 
         RowBox[{"xTemp", ",", "yTemp"}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
