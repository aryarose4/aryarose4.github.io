Cell[CellGroupData[{

Cell["Parameterization by Height", "Subsection",
 CellChangeTimes->{{3.950031273289876*^9, 3.9500312787763033`*^9}, {
  3.9500361749206753`*^9, 
  3.9500361831455173`*^9}},ExpressionUUID->"6eadeb52-75e8-42c2-99c1-\
dc60fb0b8c12"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"(", GridBox[{
      {"x11", "x12", "0", "0"},
      {"0", "0", "x23", "x24"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y", "=", 
   RowBox[{"(", GridBox[{
      {"0", "y12"},
      {"0", "y22"},
      {"y31", "0"},
      {
       RowBox[{" ", "y41"}], "0"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vars", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Flatten", "[", 
      RowBox[{"{", 
       RowBox[{"x", ",", "y"}], "}"}], "]"}], ",", "0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ivars", "=", 
   RowBox[{"{", 
    RowBox[{"x11", ",", "x12", ",", "y12", ",", "y22"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Icvars", "=", 
   RowBox[{"{", 
    RowBox[{"x23", ",", "x24", ",", "y31", ",", "y41"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Realify", "=", 
    RowBox[{
     RowBox[{"Refine", "[", 
      RowBox[{"#", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "\[Element]", "Reals"}], "&"}], "/@", "vars"}]}], "]"}],
      "&"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "represents", " ", "the", " ", "height", " ", "of", " ", 
     "the", " ", "hyperpolygon"}], ",", " ", 
    RowBox[{
    "which", " ", "should", " ", "be", " ", "exactly", " ", "half", " ", "of",
      " ", "\[CapitalPhi]U1"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalPhi]maxI", "=", 
   RowBox[{"2", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Beta]Test", "[", 
       RowBox[{"[", "3", "]"}], "]"}], "+", 
      RowBox[{"\[Beta]Test", "[", 
       RowBox[{"[", "4", "]"}], "]"}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"height", "[", "t_", "]"}], "=", 
   RowBox[{"\[CapitalPhi]maxI", "+", 
    RowBox[{"2", 
     RowBox[{"Abs", "[", "t", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sols", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Mu]U1", "[", 
            RowBox[{"x", ",", "y"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "2"}], "]"}], "]"}], "==", 
          RowBox[{"\[Beta]Test", "[", 
           RowBox[{"[", 
            RowBox[{"1", ";;", "2"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Mu]SL", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Norm", "[", 
            RowBox[{"{", 
             RowBox[{"x11", ",", "y12", ",", "x12", ",", "y22"}], "}"}], 
            "]"}], "2"], "==", 
          RowBox[{"height", "[", "t", "]"}]}]}], "}"}], "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{"Icvars", "->", "0"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x11", ",", "x12", ",", "y12", ",", "y22"}], "}"}], ",", 
      "Reals"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sols", "=", 
   RowBox[{
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Mu]U1", "[", 
            RowBox[{"x", ",", "y"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"3", ";;", "4"}], "]"}], "]"}], "==", 
          RowBox[{"\[Beta]Test", "[", 
           RowBox[{"[", 
            RowBox[{"3", ";;", "4"}], "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"\[Mu]SL", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Norm", "[", 
            RowBox[{"{", 
             RowBox[{"x23", ",", "y31", ",", "x24", ",", "y41"}], "}"}], 
            "]"}], "2"], "==", 
          RowBox[{"height", "[", "t", "]"}]}]}], "}"}], "/.", 
       RowBox[{"Thread", "[", 
        RowBox[{"Ivars", "->", "0"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x23", ",", "x24", ",", "y31", ",", "y41"}], "}"}], ",", 
      "Reals"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sols", "=", 
    RowBox[{
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Mu]U1", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "==", "\[Beta]Test"}], ",", 
         RowBox[{
          RowBox[{"\[Mu]SU2", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"\[Mu]SL", "[", 
           RowBox[{"x", ",", "y"}], "]"}], "==", "0"}], ",", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Norm", "[", 
            RowBox[{"{", 
             RowBox[{"x23", ",", "y31", ",", "x24", ",", "y41"}], "}"}], 
            "]"}], "2"], "==", 
          RowBox[{"height", "[", "t", "]"}]}]}], "}"}], ",", "vars", ",", 
       "Reals"}], "]"}], "//", "Last"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]t", "=", "0.1"}], ";", " ", 
  RowBox[{"n", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tList", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"i", " ", "\[CapitalDelta]t"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xList", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "/.", "sols"}], "/.", 
      RowBox[{"t", "->", 
       RowBox[{"i", " ", "\[CapitalDelta]t"}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yList", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"y", "/.", "sols"}], "/.", 
       RowBox[{"t", "->", 
        RowBox[{"i", " ", "\[CapitalDelta]t"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"x", "=", 
    RowBox[{"(", GridBox[{
       {"x11", "x12", "x13", "x14"},
       {"x21", "x22", "x23", "x24"}
      }], ")"}]}], ";", 
   RowBox[{"y", "=", 
    RowBox[{"(", GridBox[{
       {"y11", "y12"},
       {"y21", "y22"},
       {
        RowBox[{"y31", " "}], "y32"},
       {
        RowBox[{"y41", " "}], "y42"}
      }], ")"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GraphicsRow", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"tList", ",", "#"}], "}"}], "\[Transpose]"}], "&"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Flatten", "/@", "xList"}], ")"}], "\[Transpose]"}], 
