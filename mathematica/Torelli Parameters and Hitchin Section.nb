                  RowBox[{"1", ",", "0"}], ")"}],
                 Derivative],
                MultilineFunction->None], "[", 
               RowBox[{"u", ",", "v"}], "]"}], "2"], "-", 
             RowBox[{
              RowBox[{"h11", "[", 
               RowBox[{"u", ",", "v"}], "]"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 SuperscriptBox["h11", 
                  TagBox[
