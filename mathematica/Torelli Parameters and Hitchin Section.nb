Cell[CellGroupData[{

Cell["\<\
Section 3 - Hitchin Section in Unitary Gauge (Numerical for \[Beta] = \
\[Beta]Test)\
\>", "Chapter",
 CellChangeTimes->{{3.871385838870492*^9, 3.871385871958177*^9}, {
   3.871392286975159*^9, 3.871392289460813*^9}, {3.8717438222989326`*^9, 
   3.871743824834297*^9}, {3.8717438603476143`*^9, 3.871743860649864*^9}, 
   3.880505388213837*^9, {3.8807467741830063`*^9, 3.88074678072748*^9}, {
   3.908456072285553*^9, 3.908456110117456*^9}, 
   3.9084562047727585`*^9},ExpressionUUID->"5a72cfe7-fe15-4add-a491-\
bcd2738d732a"],

Cell[CellGroupData[{

Cell["Parameterization by Det", "Subsection",
 CellChangeTimes->{{3.9501020532613955`*^9, 
  3.950102056686143*^9}},ExpressionUUID->"6fb79224-b15e-4be9-82bb-\
c949ee4decb5"],

Cell["\<\
The Hitchin section we found in Section 2 satisfies the complex moment maps, \
but not the real ones (unless t=0).  Since points in the Hitchin section are \
stable (see criteria in Proudfoot\[CloseCurlyQuote]s hyperpolygon paper), \
there is some complex gauge transformation which will make the real moment \
map conditions hold.  In this section we numerically approximate this gauge \
transformation.\
\>", "Text",
 CellChangeTimes->{{3.871746671488085*^9, 3.871746864447784*^9}, {
  3.880505632934933*^9, 3.880505648134872*^9}, {3.9084561360375977`*^9, 
  3.9084561517736683`*^9}},ExpressionUUID->"1c01f06d-880d-4dfa-bb28-\
6bd15488221c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "is", " ", "the", " ", "parameterization", " ", "of", " ", 
     "the", " ", "Hitchin", " ", "section", " ", "given", " ", "in", " ", 
     "the", " ", "previous", " ", "section"}], ",", " ", 
    RowBox[{
     RowBox[{
     "except", " ", "we", " ", "reparameterize", " ", "with", " ", "t"}], "=", 
     RowBox[{
      RowBox[{"\[Sqrt]", "s"}], " ", "instead", " ", "for", " ", 
      "computational", " ", "ease"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", GridBox[{
          {"x11", "x12", "0", "0"},
          {"0", "0", "x23", "x24"}
         }], ")"}], "/.", "fixedPt1"}], "/.", 
      RowBox[{"Thread", "[", 
       RowBox[{"\[Beta]", "->", "\[Beta]Test"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"y", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", GridBox[{
          {"0", "y12"},
          {"0", "y22"},
          {
           RowBox[{"x24", " ", 
            SqrtBox["s"]}], "0"},
          {
           RowBox[{" ", 
            RowBox[{
             RowBox[{"-", "x23"}], " ", 
             SqrtBox["s"]}]}], "0"}
         }], ")"}], "/.", "fixedPt1"}], "/.", 
      RowBox[{"Thread", "[", 
       RowBox[{"\[Beta]", "->", "\[Beta]Test"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Again", " ", "we", " ", "use", " ", "a"}], "=", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Sqrt]", "b"}], " ", "and", " ", "\[Lambda]i"}], "=", 
       RowBox[{
        RowBox[{"\[Sqrt]", "\[Mu]i"}], " ", "for", " ", 
        RowBox[{"efficiency", ".", "  ", "In"}], " ", "conjuction", " ", 
        "with", " ", "upcoming", " ", "real", " ", "assumptions"}]}]}], ",", 
     " ", 
     RowBox[{
     "we", " ", "actually", " ", "need", " ", "positive", " ", "values", " ", 
      "for", " ", "all", " ", "the", " ", "variables"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A", "=", 
     RowBox[{"(", GridBox[{
        {
         SuperscriptBox["b", 
          RowBox[{"1", "/", "2"}]], "0"},
        {"0", 
         SuperscriptBox["b", 
          RowBox[{
           RowBox[{"-", "1"}], "/", "2"}]]}
       }], ")"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Sqrt]", "\[Mu]1"}], ",", 
       RowBox[{"\[Sqrt]", "\[Mu]2"}], ",", 
       RowBox[{"\[Sqrt]", "\[Mu]3"}], ",", 
       RowBox[{"\[Sqrt]", "\[Mu]4"}], ",", "A"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vars", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[Mu]1", ",", "\[Mu]2", ",", "\[Mu]3", ",", "\[Mu]4", ",", "b", ",", 
       "s"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Realify", "=", 
     RowBox[{
      RowBox[{"Refine", "[", 
       RowBox[{"#", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"#", "\[Element]", "Reals"}], "&"}], "/@", "vars"}]}], 
       "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Assuming", "[", 
    RowBox[{
     RowBox[{"Thread", "[", 
      RowBox[{"vars", ">", "0"}], "]"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"eq1", "=", 
       RowBox[{
        RowBox[{"\[Mu]U1", "[", 
         RowBox[{
          RowBox[{"groupActx", "[", 
           RowBox[{"g", ",", "x"}], "]"}], ",", 
          RowBox[{"groupActy", "[", 
           RowBox[{"g", ",", "y"}], "]"}]}], "]"}], "//", "Realify"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"eq2", "=", 
       RowBox[{
        RowBox[{"\[Mu]SU2", "[", 
         RowBox[{
          RowBox[{"groupActx", "[", 
           RowBox[{"g", ",", "x"}], "]"}], ",", 
          RowBox[{"groupActy", "[", 
           RowBox[{"g", ",", "y"}], "]"}]}], "]"}], "//", "Realify"}]}], 
      ";"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bsol", "=", 
     RowBox[{"Solve", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"eq1", "[", 
          RowBox[{"[", "4", "]"}], "]"}], "==", 
         RowBox[{"\[Beta]Test", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}], "}"}], ",", "b"}], "]"}]}], ";"}],
    "\[IndentingNewLine]", 
   RowBox[{"eq1", "=", 
    RowBox[{
     RowBox[{"eq1", "/.", 
      RowBox[{"bsol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "//", "FullSimplify"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"We", " ", "choose", " ", 
     RowBox[{"bsol", "[", 
      RowBox[{"[", "1", "]"}], "]"}], " ", "because", " ", 
     RowBox[{"it", "'"}], "s", " ", "positive"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"eq2", "=", 
    RowBox[{
     RowBox[{"eq2", "/.", 
      RowBox[{"bsol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "//", "FullSimplify"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sols", "=", 
     RowBox[{
      RowBox[{"Solve", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"eq1", "==", "\[Beta]Test"}], ",", 
            RowBox[{"eq2", "==", "0"}]}], "}"}], "/.", "fixedPt1"}], "//", 
         "Realify"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Mu]1", ",", "\[Mu]2", ",", "\[Mu]3", ",", "\[Mu]4"}], 
         "}"}], ",", "Reals", ",", 
        RowBox[{"Assumptions", "->", 
         RowBox[{"{", 
          RowBox[{"s", ">", "0"}], "}"}]}]}], "]"}], "//", "FullSimplify"}]}],
     ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"This", " ", "is", " ", "broken", " ", "right", " ", "now"}], 
    "*)"}], 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"In", " ", "what", " ", "follows"}], ",", " ", 
      RowBox[{
      "each", " ", "calculation", " ", "will", " ", "be", " ", "done", " ", 
       "for", " ", "various", " ", "t", " ", "values", " ", "and", " ", "put",
        " ", "in", " ", "a", " ", "list", " ", 
       RowBox[{"(", 
        RowBox[{"often", " ", "lists", " ", "of", " ", "matrices"}], ")"}]}], 
      ",", " ", 
      RowBox[{"hence", " ", "the", " ", "use", " ", "of", " ", "Table", " ", 
       RowBox[{"and", " ", "/@"}]}]}], "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     StyleBox[
      RowBox[{"\[CapitalDelta]t", "=", "0.1"}],
      FontColor->RGBColor[0.3176470588235294, 0.6666666666666666, 0.]], 
     StyleBox[";",
      FontColor->RGBColor[0.3176470588235294, 0.6666666666666666, 0.]], 
     StyleBox[" ",
      FontColor->RGBColor[0.3176470588235294, 0.6666666666666666, 0.]], 
     StyleBox[
      RowBox[{"n", "=", "50"}],
      FontColor->RGBColor[0.3176470588235294, 0.6666666666666666, 0.]], 
     StyleBox[";",
      FontColor->RGBColor[0.3176470588235294, 0.6666666666666666, 0.]], 
     "\[IndentingNewLine]", 
     RowBox[{"tvals", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[CapitalDelta]t", " ", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
     RowBox[{"svals", "=", 
      SuperscriptBox["tvals", "2"]}], ";", 
     StyleBox["\[IndentingNewLine]",
      FontColor->RGBColor[0, 1, 0]], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "We", " ", "found", " ", "the", " ", "gauge", " ", "transformation"}], 
       ",", " ", 
       RowBox[{
       "so", " ", "we", " ", "apply", " ", "it", " ", "to", " ", "obtain", 
        " ", "the", " ", "same", " ", "hyperpolygon", " ", "in", " ", 
        "unitary", " ", 
        RowBox[{"gauge", ".", " ", "We"}], " ", "choose", " ", 
        RowBox[{"sols", "[", 
         RowBox[{"[", "3", "]"}], "]"}], " ", "because", " ", "it", " ", 
        "has", " ", "positive", " ", "solutions"}]}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"\[Lambda]vals", "=", 
      RowBox[{
       RowBox[{"\[Sqrt]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\[Mu]1", ",", "\[Mu]2", ",", "\[Mu]3", ",", "\[Mu]4"}], 
             "}"}], "/.", 
            RowBox[{"sols", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "/.", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Thread", "[", 
             RowBox[{"s", "->", "svals"}], "]"}], "}"}], "\[Transpose]"}]}], 
         ")"}]}], "//", "N"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"avals", "=", 
      RowBox[{"\[Sqrt]", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "/.", 
           RowBox[{"bsol", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "/.", 
          RowBox[{"sols", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "/.", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Thread", "[", 
            RowBox[{"s", "->", "svals"}], "]"}], "}"}], "\[Transpose]"}]}], 
        "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", GridBox[{
           {"#", "0"},
           {"0", 
            SuperscriptBox["#", 
             RowBox[{"-", "1"}]]}
          }], ")"}], "&"}], "/@", "avals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"xNumerical", "=", 
      RowBox[{"Chop", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"groupActx", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"\[Lambda]vals", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"A", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}], ",", "x"}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"yNumerical", "=", 
      RowBox[{"Chop", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"groupActy", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"\[Lambda]vals", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"A", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "}"}]}], "]"}], ",", 
           RowBox[{"y", "/.", 
            RowBox[{"s", "->", 
             RowBox[{"svals", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"Length", "[", "tvals", "]"}]}], "}"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Verify", " ", "the", " ", "moment", " ", "map", " ", "conditions", " ",
        "are", " ", "satisfied"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Mu]U1", "[", 
        RowBox[{
         RowBox[{"xNumerical", "[", 
          RowBox[{"[", "10", "]"}], "]"}], ",", 
         RowBox[{"yNumerical", "[", 
          RowBox[{"[", "10", "]"}], "]"}]}], "]"}], "//", 
       RowBox[{"Chop", "\[IndentingNewLine]", 
        RowBox[{"\[Mu]SU2", "[", 
         RowBox[{
          RowBox[{"xNumerical", "[", 
           RowBox[{"[", "10", "]"}], "]"}], ",", 
          RowBox[{"yNumerical", "[", 
           RowBox[{"[", "10", "]"}], "]"}]}], "]"}]}]}], "//", 
      RowBox[{"Chop", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         SubscriptBox["\[Mu]", 
          RowBox[{"C", "*"}]], " ", "values"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"\[Mu]CStarVals", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", "#", "]"}], ".", 
           RowBox[{"Flatten", "[", "#", "]"}]}], "&"}], "/@", 
         "yNumerical"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Tau]1Test", "=", 
      RowBox[{
       RowBox[{"\[Beta]Test", "[", 
        RowBox[{"[", "3", "]"}], "]"}], "+", 
       RowBox[{"\[Beta]Test", "[", 
        RowBox[{"[", "4", "]"}], "]"}], "-", 
       RowBox[{"\[Beta]Test", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "-", 
       RowBox[{"\[Beta]Test", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"\[Tau]1Test", "+", 
        RowBox[{"2", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"xNumerical", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "2", ",", "j"}], "]"}], "]"}], "2"], 
            RowBox[{
             SuperscriptBox[
              RowBox[{"yNumerical", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}], "2"], "/", 
             RowBox[{"(", 
              RowBox[{"2", 
               RowBox[{"\[Beta]Test", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "3", ",", "4"}], "}"}]}], "]"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ListPlot", "[", 
       RowBox[{"{", 
        RowBox[{"\[Mu]CStarVals", ",", "%"}], "}"}], "]"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
