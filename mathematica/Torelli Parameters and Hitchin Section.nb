   "\[IndentingNewLine]", 
   RowBox[{"gx", "=", 
    RowBox[{"groupActx", "[", 
     RowBox[{"g", ",", "x"}], "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"first", "=", 
    RowBox[{"Realify", "@", 
     RowBox[{"\[Mu]U1", "[", 
      RowBox[{"gx", ",", "y"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"second", "=", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Realify", "[", 
        RowBox[{"\[Mu]SU2", "[", 
         RowBox[{"gx", ",", "y"}], "]"}], "]"}], " ", "/.", "CStarRules"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", "->", "1"}], ",", 
