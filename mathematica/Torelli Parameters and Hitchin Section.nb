Cell["\<\
These are the Torelli parameters for the exterior spheres.  You can play \
around with adjusting the parabolic weights.  Sections 1 and 2 work for \
symbolic values for \[Beta], but Sections 3 and 4 will get much more \
complicated when \[Beta] isn\[CloseCurlyQuote]t numerical.\
\>", "Text",
 CellChangeTimes->{{3.8717508890471907`*^9, 3.8717510572229238`*^9}, {
  3.874528845722836*^9, 3.874528850978197*^9}, {3.893850142413411*^9, 
  3.8938501424290347`*^9}},ExpressionUUID->"9a62f818-69a7-4edc-94d7-\
e317e5d744c9"]
}, Open  ]],

