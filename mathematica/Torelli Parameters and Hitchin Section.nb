          RowBox[{"Flatten", "[", "#", "]"}]}], "]"}]}], "&"}], "/@", 
      "xNumerical"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Mu]CCondition", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
