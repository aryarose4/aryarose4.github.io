Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "x", ",", "y", ",", "x1", ",", "y1", ",", "xdot1", ",", "ydot1", ",", "xx", 
   ",", "yy", ",", "\[Lambda]"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", 
   RowBox[{"(", GridBox[{
      {"x1"},
      {"0"}
     }], ")"}]}], ";", 
  RowBox[{"y", "=", 
   RowBox[{"(", GridBox[{
      {"0", "y2"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xdot", "=", 
   RowBox[{"(", GridBox[{
      {"xdot1"},
      {"xdot2"}
     }], ")"}]}], ";", 
  RowBox[{"ydot", "=", 
   RowBox[{"(", GridBox[{
      {"ydot1", "ydot2"}
     }], ")"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xx", "[", "t_", "]"}], ":=", 
   RowBox[{"x", "+", 
    RowBox[{"t", " ", "xdot"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yy", "[", "t_", "]"}], ":=", 
   RowBox[{"y", "+", 
    RowBox[{"t", " ", "ydot"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"MyNorm", "[", "v_", "]"}], ":=", 
   SqrtBox[
    RowBox[{"Tr", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", "v", "]"}], ".", "v"}], "]"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NN", "[", "t_", "]"}], ":=", 
   FractionBox[
    RowBox[{"TraceFree", "[", 
     RowBox[{
      RowBox[{"xx", "[", "t", "]"}], ".", 
      RowBox[{
       RowBox[{"xx", "[", "t", "]"}], "\[Transpose]"}]}], "]"}], 
    SuperscriptBox[
     RowBox[{"MyNorm", "[", 
      RowBox[{"xx", "[", "t", "]"}], "]"}], "2"]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Lambda]", "[", 
    RowBox[{"r_", ",", "R_", ",", "t_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"2", 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"[", "1", "]"}], "]"}], 
     SuperscriptBox["r", 
      RowBox[{"2", "R", " ", 
       RowBox[{"\[Beta]", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}]]}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"MyNorm", "[", 
       RowBox[{"xx", "[", "t", "]"}], "]"}], "2"], "-", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"MyNorm", "[", 
        RowBox[{"yy", "[", "t", "]"}], "]"}], "2"], 
      SuperscriptBox["r", 
       RowBox[{"4", "R", " ", 
        RowBox[{"\[Beta]", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]]}]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hR", "=", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Lambda]", "[", 
        RowBox[{"r", ",", "R", ",", "0"}], "]"}], ",", 
       SuperscriptBox[
        RowBox[{"\[Lambda]", "[", 
         RowBox[{"r", ",", "R", ",", "0"}], "]"}], 
        RowBox[{"-", "1"}]]}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"derivativeRules", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], 
       RowBox[{"Transpose", "[", 
        RowBox[{"x", "+", 
         RowBox[{"t", " ", "xdot"}]}], "]"}]}], "->", 
      RowBox[{"Transpose", "[", "xdot", "]"}]}], ",", 
     RowBox[{
      RowBox[{
       SubscriptBox["\[PartialD]", "t"], 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "+", 
           RowBox[{"t", " ", "xdot"}]}], ")"}], ".", 
         RowBox[{"Transpose", "[", 
          RowBox[{"x", "+", 
           RowBox[{"t", " ", "xdot"}]}], "]"}]}], "]"}]}], "->", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"x", ".", 
         RowBox[{"Transpose", "[", "xdot", "]"}]}], "+", 
        RowBox[{"xdot", ".", 
         RowBox[{"Transpose", "[", "x", "]"}]}]}], "]"}]}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NN", "[", "t", "]"}], "//", "MatrixForm"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ndot", "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "t"], 
     RowBox[{"NN", "[", "t", "]"}]}], "/.", 
    RowBox[{"t", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NdotPlus", "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{"Ndot", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"2", ",", "1"}], "}"}], "->", "0"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NdotMinus", "=", 
   RowBox[{"ReplacePart", "[", 
    RowBox[{"Ndot", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "->", "0"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]dotTerm1", "=", 
   RowBox[{"2", 
    RowBox[{"Log", "[", 
     RowBox[{"\[Lambda]", "[", 
      RowBox[{"r", ",", "R", ",", "0"}], "]"}], "]"}], "Ndot"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalLambda]dotTerm2", "=", 
   RowBox[{
    RowBox[{"2", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[PartialD]", "t"], 
        RowBox[{"Log", "[", 
         RowBox[{"\[Lambda]", "[", 
          RowBox[{"r", ",", "R", ",", "t"}], "]"}], "]"}]}], " ", "/.", 
