                Derivative],
               MultilineFunction->None], "[", 
              RowBox[{"u", ",", "v"}], "]"}]}], ")"}]}]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", 
            RowBox[{"4", " ", 
             SuperscriptBox[
              RowBox[{"h11", "[", 
               RowBox[{"u", ",", "v"}], "]"}], "2"]}]], 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["h11", 
                TagBox[
                 RowBox[{"(", 
                  RowBox[{"0", ",", "1"}], ")"}],
                 Derivative],
                MultilineFunction->None], "[", 
               RowBox[{"u", ",", "v"}], "]"}], "2"], "+", 
             SuperscriptBox[
              RowBox[{
               SuperscriptBox["h11", 
                TagBox[
