     "d\[Mu]SL"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d\[Mu]SLx", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
