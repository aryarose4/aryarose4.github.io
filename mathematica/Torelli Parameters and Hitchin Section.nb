              SuperscriptBox["h22", 
               TagBox[
                RowBox[{"(", 
                 RowBox[{"0", ",", "2"}], ")"}],
                Derivative],
               MultilineFunction->None], "[", 
              RowBox[{"u", ",", "v"}], "]"}], "+", 
             RowBox[{
              SuperscriptBox["h22", 
               TagBox[
                RowBox[{"(", 
