  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]Extra", "=", 
    RowBox[{"2", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"yList", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}], "2"], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "3", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "turns", " ", "out", " ", "to", " ", "be", " ", "exactly", 
    " ", "t"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"resTerms", "=", 
   RowBox[{"2", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         SuperscriptBox[
          RowBox[{"xList", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2", ",", "j"}], "]"}], "]"}], "2"], 
         RowBox[{
          SuperscriptBox[
           RowBox[{"yList", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j", ",", "1"}], "]"}], "]"}], "2"], "/", 
          RowBox[{"(", 
           RowBox[{"2", 
            RowBox[{"\[Beta]Test", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], ")"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "3", ",", "4"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"tList", ",", "#"}], "}"}], "\[Transpose]"}], "&"}], "/@", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[CapitalPhi]maxI", "+", "\[CapitalPhi]Extra"}], ",", 
      RowBox[{"\[CapitalPhi]maxI", "+", "resTerms"}]}], "}"}]}], ",", 
