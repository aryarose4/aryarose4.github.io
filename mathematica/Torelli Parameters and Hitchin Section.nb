        RowBox[{"w", "->", "0"}]}], "}"}]}], "//", 
     RowBox[{"FullSimplify", "\[IndentingNewLine]", 
      RowBox[{"Simplify", "@", 
       RowBox[{"ComplexExpand", "@", 
        RowBox[{"Realify", "@", 
         RowBox[{"Re", "[", "second", "]"}]}]}]}]}]}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"Simplify", "@", 
    RowBox[{"ComplexExpand", "@", 
     RowBox[{"Realify", "@", 
      RowBox[{"Im", "[", "second", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"sols", "=", 
    RowBox[{"Solve", "[", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"second", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"second", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "/", "a"}], "==", "0"}]}], 
       "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"a", ",", "c", ",", "ic"}], "}"}], ",", 
      RowBox[{"Assumptions", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", ">", "0"}], ",", 
         RowBox[{"a", "\[Element]", "Reals"}], ",", 
         RowBox[{"c", "\[Element]", "Reals"}], ",", 
         RowBox[{"ic", "\[Element]", "Reals"}], ",", 
