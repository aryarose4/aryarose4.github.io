Notebook[{

Cell[CellGroupData[{
Cell["Introduction", "Subsection",
 CellChangeTimes->{{3.96021542874876*^9, 
  3.9602154325505676`*^9}},ExpressionUUID->"1a636599-426a-3c43-bd91-\
fbd6e094325f"],

Cell[TextData[{
 "Consider the representation ",
 Cell[BoxData[
  RowBox[{"x", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {"1", "0", "1", "1"},
      {"0", "1", "1", 
       SuperscriptBox["r\[ExponentialE]", "\[ImaginaryI]\[Theta]"]}
     }], ")"}]}]], "Text",
  CellChangeTimes->{{3.960200915346834*^9, 3.960201070564234*^9}, {
    3.960201108215189*^9, 3.960201142643566*^9}, {3.960201177936653*^9, 
    3.960201262856505*^9}, {3.960201314109999*^9, 3.960201342762432*^9}, {
    3.9602015152359085`*^9, 3.960201540666792*^9}, {3.9602027217741776`*^9, 
    3.960202998393053*^9}, {3.960203035506834*^9, 3.960203037616598*^9}, {
    3.960203082191813*^9, 3.960203128698723*^9}, {3.960203159004858*^9, 
    3.9602033253830357`*^9}, {3.96020339992552*^9, 3.960203400487161*^9}, {
    3.960203442890217*^9, 3.960203629371441*^9}, {3.960203674648033*^9, 
    3.960203687692436*^9}, {3.960204174993009*^9, 3.960204178065995*^9}, {
    3.960204804178356*^9, 3.960204809961481*^9}, {3.960205745670916*^9, 
    3.960205935378677*^9}, {3.960205978803974*^9, 3.960205981238935*^9}, {
    3.960206016363785*^9, 3.9602060642648287`*^9}, 3.9602061843148327`*^9, {
    3.9602063301172047`*^9, 3.960206352104378*^9}, {3.960206405697111*^9, 
    3.9602065234399147`*^9}, {3.960206560592844*^9, 3.960206562534518*^9}, {
    3.960206593875122*^9, 3.9602070705038376`*^9}},ExpressionUUID->
  "7524281f-441e-a44b-8b79-3063d6e34d8f"],
 " and ",
 Cell[BoxData[
  RowBox[{"y", " ", "=", " ", 
   RowBox[{"(", GridBox[{
      {
       SubscriptBox["y", "11"], 
       SubscriptBox["y", "12"]},
      {
       SubscriptBox["y", "21"], 
       SubscriptBox["y", "22"]},
      {
       SubscriptBox["y", "31"], 
       SubscriptBox["y", "32"]},
      {
       SubscriptBox["y", "41"], "t"}
     }], ")"}]}]], "Text",
  CellChangeTimes->{{3.960200915346834*^9, 3.960201070564234*^9}, {
    3.960201108215189*^9, 3.960201142643566*^9}, {3.960201177936653*^9, 
    3.960201262856505*^9}, {3.960201314109999*^9, 3.960201342762432*^9}, {
    3.9602015152359085`*^9, 3.960201540666792*^9}, {3.9602027217741776`*^9, 
    3.960202998393053*^9}, {3.960203035506834*^9, 3.960203037616598*^9}, {
    3.960203082191813*^9, 3.960203128698723*^9}, {3.960203159004858*^9, 
    3.9602033253830357`*^9}, {3.96020339992552*^9, 3.960203400487161*^9}, {
    3.960203442890217*^9, 3.960203629371441*^9}, {3.960203674648033*^9, 
    3.960203687692436*^9}, {3.960204174993009*^9, 3.960204178065995*^9}, {
    3.960204804178356*^9, 3.960204809961481*^9}, {3.960205745670916*^9, 
    3.960205935378677*^9}, {3.960205978803974*^9, 3.960205981238935*^9}, {
    3.960206016363785*^9, 3.9602060642648287`*^9}, 3.9602061843148327`*^9, {
    3.9602063301172047`*^9, 3.960206352104378*^9}, {3.960206405697111*^9, 
    3.9602065234399147`*^9}, {3.960206560592844*^9, 3.960206562534518*^9}, {
    3.960206593875122*^9, 3.9602070705038376`*^9}},ExpressionUUID->
  "724f37c9-6349-714c-ac65-fa704b319b44"],
 " where the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox[
        StyleBox["y", "TI"], 
        RowBox[{
          StyleBox["i", "TI"], 
          StyleBox["j", "TI"]}]], TraditionalForm], "errors" -> {}, "input" -> 
     "y_{ij}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b1c960a4-05ff-1d4f-8c71-16647f7cfb5e"],
 " are uniquely determined by ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["C", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], ")"}], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\mu_\\mathbb{C}(x,y)=0",
      "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d1311251-2825-8b46-abb5-180e269539d3"],
 ".  For each ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["c", "TI"], ",", 
           StyleBox["d", "TI"], ",", 
           StyleBox["t", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "(c,d,t)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e3328f73-e8f8-fa4b-a5ba-a0609a47edfb"],
 " triple I\[CloseCurlyQuote]ve generated a new representation in the same \
orbit solving ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Mu]", 
          StyleBox["R", FontSlant -> "Plain"]], 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["y", "TI"]}], ")"}], "\[LongEqual]", "\[Beta]"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\mu_\\mathbb{R}(x,y)=\\beta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "754e380b-242f-a94f-b47e-189e7a48afda"],
 " where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Beta]", "\[LongEqual]", 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", "6"], ",", 
             FractionBox["1", "7"], ",", 
             FractionBox["1", "7"], ",", 
             FractionBox["1", "10"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "\\beta=(\\frac16,\\frac17,\\frac17,\\frac1{10})", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a6baa2bb-d13a-7549-a982-3cd384f4dc7a"],
 ".  When ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "t=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1d9b20af-161c-a847-8e2e-46523340ae64"],
 ", the values of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "\[Theta]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "re^{i\\theta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "835f0071-5b21-5c47-a4af-3472a3185171"],
 " parametrize polygon space.  Given a fixed ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "\[Theta]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "re^{i\\theta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27f15aee-bd4c-4142-b230-2eb7e1ddc792"],
 ", increasing ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["t", "TI"], ">", "0"}], TraditionalForm], "errors" -> {}, 
     "input" -> "t>0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "63e0a80d-3218-cb42-8402-2c35ba2642ff"],
 " corresponds to flowing up along the moment map induced by the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["U", "TI"], "(", "1", ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "U(1)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c266e0bf-f869-3148-8a05-1dee97b129e6"],
 "-action.  The short subsets are ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"{", 
           RowBox[{"1", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
           RowBox[{"2", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
           RowBox[{"3", ",", "4"}], "}"}]}], TraditionalForm], "errors" -> {},
      "input" -> "\\{1,4\\},\\{2,4\\},\\{3,4\\}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "577c2d97-34ad-e240-bb51-8a4da5189075"],
 ", and these subsets are straight when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], 
         SuperscriptBox[
          StyleBox["e", "TI"], 
          RowBox[{
            StyleBox["i", "TI"], "\[Theta]"}]]}], TraditionalForm], 
     "errors" -> {}, "input" -> "re^{i\\theta}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3edd59f9-dea1-cd4a-9f3b-317f26c4457f"],
 " is 0, 1, and \[Infinity] respectively.  These are the most interesting \
points to flow up from.  I reparametrized ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["r", "TI"], "\[RightTeeArrow]", 
         FractionBox[
          StyleBox["r", "TI"], 
          RowBox[{"1", "-", 
            StyleBox["r", "TI"]}]]}], TraditionalForm], "errors" -> {}, 
     "input" -> "r\\mapsto\\frac{r}{1-r}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "595affae-ec5d-914b-9995-62c3b4c7c766"],
 " so that the short subsets are straight when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"(", 
         RowBox[{
           StyleBox["r", "TI"], ",", "\[Theta]"}], ")"}], TraditionalForm], 
     "errors" -> {}, "input" -> "(r,\\theta)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "76a39e9e-0304-734f-947b-2165cd49daf9"],
 " is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{"0", ",", "0"}], ")"}], ",", 
         RowBox[{"(", 
           RowBox[{
             FractionBox["1", "2"], ",", "0"}], ")"}], ",", 
         RowBox[{"(", 
           RowBox[{"1", ",", "0"}], ")"}]}], TraditionalForm], "errors" -> {},
      "input" -> "(0,0), (\\frac12,0),(1,0)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3382abe4-5f99-bd49-b3c2-5a0ea2d5ef45"],
 "."
}], "Text",
 CellChangeTimes->{
  3.960215418642782*^9, {3.9611566125182667`*^9, 3.961156686944874*^9}, {
   3.9611567252189827`*^9, 3.9611567486324425`*^9}, {3.9611568155068455`*^9, 
   3.9611569353150063`*^9}, 
   3.961156986270727*^9},ExpressionUUID->"36273c46-8334-ec48-9806-\
5401b5e6ae67"]
}, Open  ]],

Cell[CellGroupData[{

Cell["The Program", "Subsection",
 CellChangeTimes->{{3.9602154405154724`*^9, 
  3.9602154542778645`*^9}},ExpressionUUID->"82b8657d-d9ca-f641-948e-\
4f78efdab15d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Imports", " ", 
    RowBox[{"data", ".", "  ", 
     RowBox[{"Takes", " ", "~", "3"}]}], " ", "mins", " ", "to", " ", 
    RowBox[{"load", ".", "  ", "Change"}], " ", "to", " ", 
    "\"\<hyperpolygonDataLowRes\>\"", " ", 
    RowBox[{"for", " ", "~", "25"}], " ", "sec", " ", "version"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hyperpolygonData", "=", 
     RowBox[{"ToExpression", "[", 
      RowBox[{
       RowBox[{"Import", "[", "\"\<hyperpolygonDataPolar\>\"", "]"}], ",", 
       "TraditionalForm"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "rRange", ",", "\[Theta]Range", ",", "tRange", ",", 
       "hyperpolygonVals"}], "}"}], "=", "hyperpolygonData"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Basis", " ", "of", " ", "su", 
     RowBox[{"(", "2", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"b1", "=", 
     RowBox[{"(", GridBox[{
        {"0", "\[ImaginaryI]"},
        {"\[ImaginaryI]", "0"}
       }], ")"}]}], ";", 
    RowBox[{"b2", "=", 
     RowBox[{"(", GridBox[{
        {"0", "1"},
        {
         RowBox[{"-", "1"}], "0"}
       }], ")"}]}], ";", 
    RowBox[{"b3", "=", 
     RowBox[{"(", GridBox[{
        {"\[ImaginaryI]", "0"},
        {"0", 
         RowBox[{"-", "\[ImaginaryI]"}]}
       }], ")"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Writes", " ", "elements", " ", "of"}], " ", "-", 
     RowBox[{"\[ImaginaryI]su", 
      RowBox[{"(", "2", ")"}], " ", "as", " ", "vectors", " ", "in", " ", 
      SuperscriptBox[
       TemplateBox[{},
        "Reals"], "3"]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ToCoordinates", "[", "A_", "]"}], "=", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"b1", ".", "A"}]}], "]"}], ",", 
        RowBox[{"Tr", "[", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"b2", ".", "A"}]}], "]"}], ",", 
        RowBox[{"Tr", "[", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"b3", ".", "A"}]}], "]"}]}], "}"}]}]}], ";"}], 
   StyleBox["\[IndentingNewLine]",
    FontColor->RGBColor[
     0.7019607843137254, 0.7019607843137254, 0.7019607843137254]], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Given", " ", "a", " ", "representation", " ", "x"}], 
      "\[Element]", 
      RowBox[{"Hom", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["C", "4"], ",", 
         SuperscriptBox["C", "2"]}], ")"}]}]}], ",", " ", 
     RowBox[{"y", "\[Element]", 
      RowBox[{"Hom", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["C", "2"], ",", 
         SuperscriptBox["C", "4"]}], ")"}]}]}], ",", " ", 
     RowBox[{
     "this", " ", "displays", " ", "the", " ", "hyperpolygon", " ", "in", " ", 
      SuperscriptBox[
       TemplateBox[{},
        "Reals"], "3"]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ShowHyperpolygon", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "v", ",", "w", ",", "vertices", ",", "hyperpolygon", ",", 
           "plotBounds"}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"v", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", 
                 RowBox[{"i", ";;", "i"}]}], "]"}], "]"}], ".", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"i", ";;", "i"}]}], "]"}], "]"}], 
               "\[ConjugateTranspose]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"w", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"i", ";;", "i"}], ",", "All"}], "]"}], "]"}], 
               "\[ConjugateTranspose]"}], ".", 
              RowBox[{"y", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", ";;", "i"}], ",", "All"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Creates", " ", "vertices", " ", "of", " ", "polygon"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"vertices", "=", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", "0"}], "}"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"vertices", ",", 
               RowBox[{
                RowBox[{"Last", "[", "vertices", "]"}], "+", 
                RowBox[{"ToCoordinates", "[", 
                 RowBox[{"v", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"vertices", ",", 
               RowBox[{
                RowBox[{"Last", "[", "vertices", "]"}], "-", 
                RowBox[{"ToCoordinates", "[", 
                 RowBox[{"w", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "]"}]}]}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Draws", " ", "lines", " ", "between", " ", "vertices"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"hyperpolygon", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"hyperpolygon", ",", "Black"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"hyperpolygon", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"vertices", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"vertices", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}]}], "}"}], "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"hyperpolygon", ",", 
               RowBox[{"Darker", "@", "Green"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"hyperpolygon", ",", 
               RowBox[{"Line", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"vertices", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"vertices", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", "+", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], 
              "]"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "7", ",", "2"}], "}"}]}], "]"}], ";",
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Creates", " ", "graph"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"plotBounds", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Min", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"-", ".2"}]}], "]"}], ",", 
               RowBox[{"Max", "[", 
                RowBox[{"#", ",", ".2"}], "]"}]}], "}"}], "&"}], "/@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Re", "[", "vertices", "]"}], "\[Transpose]"}], 
