Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Beta]", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "6"], ",", 
     FractionBox["1", "7"], ",", 
     FractionBox["1", "7"], ",", 
     FractionBox["1", "10"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalPhi]U1", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Re", "@", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"i", ";;", "i"}], ",", "All"}], "]"}], "]"}], ".", 
         RowBox[{
          RowBox[{"y", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", ";;", "i"}], ",", "All"}], "]"}], "]"}], 
          "\[ConjugateTranspose]"}]}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"residueNormSquared", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Re", "@", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", 
         RowBox[{"\[Beta]", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]], 
       RowBox[{"Tr", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"y", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"i", ";;", "i"}], ",", "All"}], "]"}], "]"}], 
          "\[ConjugateTranspose]"}], ".", 
         RowBox[{
          RowBox[{"x", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"i", ";;", "i"}]}], "]"}], "]"}], 
          "\[ConjugateTranspose]"}], ".", 
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"i", ";;", "i"}]}], "]"}], "]"}], ".", 
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"i", ";;", "i"}], ",", "All"}], "]"}], "]"}]}], "]"}]}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "4"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"testVal", "=", 
