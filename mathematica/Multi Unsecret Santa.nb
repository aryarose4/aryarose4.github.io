Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"people", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Mom\>\"", ",", "\"\<Dad\>\"", ",", "\"\<Laurel & Josh\>\"", ",", 
     "\"\<Drew & Siobhan\>\"", ",", "\"\<Arya\>\"", ",", "\"\<Hunter\>\"", 
     ",", "\"\<Racquel\>\""}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numberOfRounds", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"numberOfPeople", "=", 
   RowBox[{"Length", "[", "people", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"roundsColumn", "=", 
   RowBox[{"{", "}"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"giftArray", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"\"\<\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"numberOfRounds", ",", "numberOfPeople"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", " ", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", "numberOfRounds"}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"roundsColumn", ",", 
      RowBox[{"{", 
       RowBox[{"StringJoin", "[", 
        RowBox[{"\"\<Round \>\"", ",", 
         RowBox[{"ToString", "[", "i", "]"}], ",", "\"\<:\>\""}], "]"}], 
       "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", "=", "1"}], ",", 
      RowBox[{"j", "<=", "numberOfPeople"}], ",", 
      RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"excluding", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"people", "[", 
            RowBox[{"[", "j", "]"}], "]"}], "}"}], ",", 
          RowBox[{"giftArray", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", 
             RowBox[{"1", ";;", 
              RowBox[{"j", "-", "1"}]}]}], "]"}], "]"}], ",", 
          RowBox[{"giftArray", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"1", ";;", 
              RowBox[{"i", "-", "1"}]}], ",", "j"}], "]"}], "]"}]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"giftArray", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
        RowBox[{"RandomChoice", "[", 
         RowBox[{"DeleteElements", "[", 
          RowBox[{"people", ",", "excluding"}], "]"}], "]"}]}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"header", "=", 
   RowBox[{"{", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"{", "\"\<Gift Giver:\>\"", "}"}], ",", "people"}], "]"}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"blankRow", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"\"\<\>\"", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"numberOfPeople", "+", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Join", "[", 
   RowBox[{"header", ",", "blankRow", ",", 
    RowBox[{"Join", "[", 
     RowBox[{"roundsColumn", ",", "giftArray", ",", "2"}], "]"}]}], "]"}], "//",
   "TableForm"}]}], "Input",
 CellChangeTimes->{{3.972825176179296*^9, 3.9728253358328466`*^9}, {
