{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "site: refresh",
      "type": "shell",
      "command": "./bin/refresh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "site: serve",
      "type": "shell",
      "command": "bundle exec jekyll serve --host 0.0.0.0 --port 8080",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}